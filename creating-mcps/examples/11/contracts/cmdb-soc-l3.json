      "description": "Hosts with a given vulnerability (CVE id), by finding status (default: open) and\noptionally environment. `total` counts them all; `hosts` lists at most `limit` (1-50).",
      "inputSchema": {
        "properties": {
          "cve_id": {
            "title": "Cve Id",
            "type": "string"
          },
          "environment": {
            "anyOf": [
              {
                "enum": [
                  "prod",
                  "staging",
                  "dev"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Environment"
          },
          "limit": {
            "default": 50,
            "title": "Limit",
            "type": "integer"
          },
          "status": {
            "default": "open",
            "enum": [
              "open",
              "mitigated",
              "accepted"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "cve_id"
        ],
        "title": "hosts_with_vulnerabilityArguments",
        "type": "object"
