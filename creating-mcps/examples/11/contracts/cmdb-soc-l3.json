            "title": "Cve Id",
            "type": "string"
          },
          "hosts": {
            "items": {
              "type": "string"
            },
            "title": "Hosts",
            "type": "array"
          },
          "severity": {
            "title": "Severity",
            "type": "string"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
