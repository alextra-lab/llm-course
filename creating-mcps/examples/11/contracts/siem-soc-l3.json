{
  "instructions": "SOC incidents and logs (OpenSearch). Times are UTC unless you pass tz. Start from an incident's suggested_window, or a window you choose. Count before you read: event_histogram for when, top_values for who, then search_events for the events.",
  "tools": [
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "How many events per time bucket: use it first, to find when something happened.\nWindow: start/end as ISO 8601 (2026-10-09T02:00:00Z) or relative (now-24h); up to 21 days.\nfilters: exact values on catalogued fields, e.g. {\"event.outcome\": \"failure\"}, a list for\nany-of, or a range {\"gte\": 500}. text: words to find in the message. interval: auto, or\none of 1m 5m 10m 15m 30m 1h 3h 6h 12h 1d.",
      "inputSchema": {
        "properties": {
          "dataset": {
            "enum": [
              "auth",
              "web",
              "syslog",
              "edr"
            ],
            "title": "Dataset",
            "type": "string"
          },
          "end": {
            "default": "now",
            "title": "End",
            "type": "string"
          },
          "filters": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Filters"
          },
          "interval": {
            "default": "auto",
            "title": "Interval",
            "type": "string"
          },
          "start": {
            "title": "Start",
            "type": "string"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Text"
          },
          "tz": {
            "default": "UTC",
            "title": "Tz",
            "type": "string"
          }
        },
        "required": [
          "dataset",
          "start"
        ],
        "title": "event_histogramArguments",
        "type": "object"
      },
      "name": "event_histogram",
      "outputSchema": {
        "additionalProperties": true,
        "title": "event_histogramDictOutput",
        "type": "object"
      }
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "One incident in full, with a suggested_window to start the investigation in (from an\nhour before it was raised to an hour after).",
      "inputSchema": {
        "properties": {
          "incident_id": {
            "title": "Incident Id",
            "type": "string"
          }
        },
        "required": [
          "incident_id"
        ],
        "title": "get_incidentArguments",
        "type": "object"
      },
      "name": "get_incident",
      "outputSchema": {
        "additionalProperties": true,
        "title": "get_incidentDictOutput",
        "type": "object"
      }
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "SOC incidents, newest first. Active ones: status [\"open\", \"in_progress\"].\n`since`/`until` bound when they were created (ISO 8601 or now-7d). `total` is how many\nmatch; page with `offset`.",
      "inputSchema": {
        "properties": {
          "host": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Host"
          },
          "limit": {
            "default": 20,
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "default": 0,
            "title": "Offset",
            "type": "integer"
          },
          "severity": {
            "anyOf": [
              {
                "enum": [
                  "low",
                  "medium",
                  "high"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Severity"
          },
          "since": {
            "default": "now-21d",
            "title": "Since",
            "type": "string"
          },
          "status": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "open",
                    "in_progress",
                    "closed",
                    "false_positive"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Status"
          },
          "until": {
            "default": "now",
            "title": "Until",
            "type": "string"
          }
        },
        "title": "list_incidentsArguments",
        "type": "object"
      },
      "name": "list_incidents",
      "outputSchema": {
        "additionalProperties": true,
        "title": "list_incidentsDictOutput",
        "type": "object"
      }
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "The matching events themselves, oldest first, a page at a time. The window can be at\nmost 24h: find it with event_histogram first. Same filters and text as event_histogram.\nfields: which fields to return (default: a short set per dataset). `total` is every match;\nif next_cursor is set, call again with the SAME arguments plus cursor for the next page.",
      "inputSchema": {
        "properties": {
          "cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Cursor"
          },
          "dataset": {
            "enum": [
              "auth",
              "web",
              "syslog",
              "edr"
            ],
            "title": "Dataset",
            "type": "string"
          },
          "end": {
            "default": "now",
            "title": "End",
            "type": "string"
          },
          "fields": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Fields"
          },
          "filters": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Filters"
          },
          "limit": {
            "default": 20,
            "title": "Limit",
            "type": "integer"
          },
          "newest_first": {
            "default": false,
            "title": "Newest First",
            "type": "boolean"
          },
          "start": {
            "title": "Start",
            "type": "string"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Text"
          },
          "tz": {
            "default": "UTC",
            "title": "Tz",
            "type": "string"
          }
        },
        "required": [
          "dataset",
          "start"
        ],
        "title": "search_eventsArguments",
        "type": "object"
      },
      "name": "search_events",
      "outputSchema": {
        "additionalProperties": true,
        "title": "search_eventsDictOutput",
        "type": "object"
      }
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "The most common values of one field, with counts: use it to find who or what is behind\na spike (source.ip, user.name, host.name, ...). Same window, filters and text as\nevent_histogram. `other_count` is how many matching events had some other value.",
      "inputSchema": {
        "properties": {
          "dataset": {
            "enum": [
              "auth",
              "web",
              "syslog",
              "edr"
            ],
            "title": "Dataset",
            "type": "string"
          },
          "end": {
            "default": "now",
            "title": "End",
            "type": "string"
          },
          "field": {
            "title": "Field",
            "type": "string"
          },
          "filters": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Filters"
          },
          "size": {
            "default": 10,
            "title": "Size",
            "type": "integer"
          },
          "start": {
            "title": "Start",
            "type": "string"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Text"
          },
          "tz": {
            "default": "UTC",
            "title": "Tz",
            "type": "string"
          }
        },
        "required": [
          "dataset",
          "field",
          "start"
        ],
        "title": "top_valuesArguments",
        "type": "object"
      },
      "name": "top_values",
      "outputSchema": {
        "additionalProperties": true,
        "title": "top_valuesDictOutput",
        "type": "object"
      }
    }
  ]
}
