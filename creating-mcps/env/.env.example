# Copy to env/.env and change the passwords. docker compose and env.py both read env/.env.
# (Your LLM endpoint settings stay in the repo-root .env from the Foundations course.)

# --- Which estate am I talking to? ---------------------------------------------------
# Laptop (default): everything on 127.0.0.1, started by `python env/env.py up`.
# Shared lab server: set PG_HOST / OS_HOST to the server, and use the persona passwords
# your instructor gives you. Learners on a shared server never run `up`, `seed` or `reset`.
PG_HOST=127.0.0.1
OS_HOST=127.0.0.1

# Several isolated estates on one server (one per learner)? Give each its own project
# name and ports, e.g. COMPOSE_PROJECT_NAME=mcp-alice, PG_PORT=5501, OS_PORT=9301.
COMPOSE_PROJECT_NAME=creating-mcps
PG_PORT=5433
OS_PORT=9200
DASHBOARDS_PORT=5601
# 127.0.0.1 keeps the databases off your network. A shared lab server sets 0.0.0.0
# (and should sit behind a firewall that only admits the learners).
PG_BIND=127.0.0.1
OS_BIND=127.0.0.1

# --- Admin credentials (used by up / seed / reset only) ------------------------------
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=Cmdb#Admin-5287-Granite
PG_DATABASE=cmdb
PG_MAX_CONNECTIONS=100
# OpenSearch rejects weak passwords (it scores them, and rejects any that resemble the
# user name). These examples pass; CHANGE THEM, especially on a shared server.
OS_ADMIN_PASSWORD=Siem#Keeper-7319-Quartz
OS_HEAP=1g

# --- Personas: who the agents act as -------------------------------------------------
# `seed` creates the same four personas in Postgres and OpenSearch (see env/README.md).
# One password per persona; OpenSearch's strength rules apply to these too.
PERSONA_L1_PASSWORD=Tier1#Desk-4821-Maple
PERSONA_L3_PASSWORD=Tier3#Hunt-9054-Cedar
PERSONA_AUDITOR_PASSWORD=Ledger#Review-3367-Birch
PERSONA_SERVICE_PASSWORD=Gateway#Svc-6140-Alder

# --- TLS to OpenSearch ---------------------------------------------------------------
# The demo security config uses a self-signed certificate. On a laptop we skip
# verification for that one local connection. A shared server should use a real
# certificate: set OS_VERIFY_CERTS=1 and OS_CA_CERTS to its CA bundle.
OS_VERIFY_CERTS=0
# OS_CA_CERTS=/path/to/lab-server-ca.pem
