# Copy this file to .env and fill in the three values below.
# Then load it into your current shell session (bash/zsh):
#
#     set -a; source .env; set +a
#
# `set -a` makes every variable you assign automatically exported into the
# environment, `source .env` runs the file, and `set +a` turns that off again.
# After this, the example scripts can read the values via os.environ.

# The base URL of your OpenAI-compatible (vLLM) endpoint. It ends in /v1.
OPENAI_BASE_URL=https://your-host/v1

# Your auth token. A hosted endpoint needs a real one. (Many *local* servers
# accept any non-empty value, e.g. "EMPTY" — but ours is hosted, so use the
# real token you were given.)
OPENAI_API_KEY=sk-replace-me

# The model id the server is serving. For this course that's gpt-oss-120b.
# If you're unsure of the exact id your endpoint uses, run:
#     python examples/01/list_models.py
MODEL=openai/gpt-oss-120b

# An EMBEDDING model id (used from Section 18 onward for embeddings/RAG).
# Embeddings usually come from a DIFFERENT model than the chat model. Set this
# to whatever embedding model your endpoint serves; if it serves only the chat
# model, the embeddings examples will tell you they can't run.
EMBED_MODEL=replace-with-embedding-model-id

# Optional: serve embeddings from a DIFFERENT endpoint than chat. Leave both unset and
# embeddings reuse OPENAI_BASE_URL/OPENAI_API_KEY above (the common case). Set them to,
# for example, run chat on a remote endpoint and embeddings on a local Ollama:
#     EMBED_BASE_URL=http://localhost:11434/v1
#     EMBED_API_KEY=ollama          # many local servers ignore the key; any value works
# EMBED_BASE_URL=
# EMBED_API_KEY=

# --- Section 16 sandboxing (optional, opt-in) --------------------------------
# The SQL-sandbox demo (examples/16/pg_sandbox.py) runs untrusted SQL against a
# locked-down Postgres. Point this at a THROWAWAY DEV database you control — never
# a real one. Leave it unset and the demo skips cleanly; the section still reads.
# Requires `pip install 'psycopg[binary]'`.
# DATABASE_URL=postgresql://user:pass@localhost:5432/devdb
#
# Optional: where examples/16/audit_log.py would ship audit lines (Elastic stack).
# Unused by default — the emitter just prints JSON lines you can forward yourself.
# ELASTICSEARCH_URL=http://localhost:9200

# --- Agent Memory course (course 2): Neo4j graph backend (optional, opt-in) ---
# The graph lessons under agent-memory/ store memory in Neo4j. Start a throwaway local
# instance (see agent-memory/README.md) and point these at it. Leave them unset and every
# graph demo skips cleanly; the lessons still read end-to-end. Requires `pip install neo4j`.
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=devpassword

# --- TLS / certificates (optional) -------------------------------------------
# Only needed if connecting fails with an SSL "CERTIFICATE_VERIFY_FAILED" error
# (common behind a corporate proxy that inspects HTTPS, or a self-signed host).
# See the README's "Troubleshooting: SSL / certificates" section.
#
# Preferred fix: point at a CA bundle / cert file to trust (keeps you secure).
# Set ONE of these (they don't merge — put every CA you need into one file). Reach for
# SSL_CERT_FILE first: it's the only one that also covers Section 1's by-hand SDK demo.
# SSL_CERT_FILE=/path/to/corporate-ca.pem
# OPENAI_CA_BUNDLE=/path/to/corporate-ca.pem    # course-specific; common.py + raw scripts
# REQUESTS_CA_BUNDLE=/path/to/corporate-ca.pem  # natively read by `requests` (Sections 1, 7)
#
# Last resort, INSECURE: skip certificate verification entirely. Only do this on
# a network you trust — it disables protection against man-in-the-middle attacks.
# OPENAI_INSECURE=1
