# Copy this file to .env and fill in the three values below.
# Then load it into your current shell session (bash/zsh):
#
#     set -a; source .env; set +a
#
# `set -a` makes every variable you assign automatically exported into the
# environment, `source .env` runs the file, and `set +a` turns that off again.
# After this, the example scripts can read the values via os.environ.

# The base URL of your OpenAI-compatible (vLLM) endpoint. It ends in /v1.
OPENAI_BASE_URL=https://your-host/v1

# Your auth token. A hosted endpoint needs a real one. (Many *local* servers
# accept any non-empty value, e.g. "EMPTY" — but ours is hosted, so use the
# real token you were given.)
OPENAI_API_KEY=sk-replace-me

# The model id the server is serving. For this course that's gpt-oss-120b.
# If you're unsure of the exact id your endpoint uses, run:
#     python examples/01/list_models.py
MODEL=openai/gpt-oss-120b

# An EMBEDDING model id (used from Section 15 onward for embeddings/RAG).
# Embeddings usually come from a DIFFERENT model than the chat model. Set this
# to whatever embedding model your endpoint serves; if it serves only the chat
# model, the embeddings examples will tell you they can't run.
EMBED_MODEL=replace-with-embedding-model-id
